# Supabase Configuration (REQUIRED)
# Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API Endpoints (optional, defaults shown)
VITE_ADSB_FI_API_URL=https://opendata.adsb.fi/api
VITE_FLIGHTAWARE_API_URL=https://aeroapi.flightaware.com/aeroapi

# Polling Configuration (optional, in milliseconds)
VITE_POLLING_INTERVAL=30000
VITE_ACTIVE_POLLING_INTERVAL=20000

# Flight Detection (optional, altitude in feet)
VITE_ALTITUDE_THRESHOLD=1300

# Operating Hours (optional, 24-hour format)
VITE_ACTIVE_HOURS_START=9
VITE_ACTIVE_HOURS_END=19

# Default Monitoring Boundary - Radlett, UK (optional)
# These define the default rectangular area for flight monitoring
VITE_DEFAULT_BOUNDARY_LAT_MIN=51.666476
VITE_DEFAULT_BOUNDARY_LAT_MAX=51.692979
VITE_DEFAULT_BOUNDARY_LON_MIN=-0.351682
VITE_DEFAULT_BOUNDARY_LON_MAX=-0.277525
